+// Channel-planar counterpart of rgb565_to_rgb888() — same decode, but writes
+// R/G/B into three separate planes (matching rgb888_to_rgb888_planar()'s
+// layout) instead of interleaved bytes. Needed for any model with an NCHW
+// input (e.g. the LiteRT/torch.export path used for YOLO11/YOLOv8) — every
+// model this conversion path previously supported used NHWC/RGB888 packed
+// input, so this combination (RGB565 camera source -> planar model input)
+// was never exercised before.
+MA_ATTR_WEAK void rgb565_to_rgb888_planar(const ma_img_t* src, ma_img_t* dst) {
+    uint16_t sw = src->width;
+    uint16_t sh = src->height;
+    uint16_t dw = dst->width;
+    uint16_t dh = dst->height;
+
+    uint32_t beta_w = (sw << 16) / dw;
+    uint32_t beta_h = (sh << 16) / dh;
+
+    uint32_t i_mul_bh_sw = 0;
+    uint32_t i_mul_dw    = 0;
+
+    uint32_t init_index  = 0;
+    uint32_t index       = 0;
+    uint32_t planar_size = dw * dh;
+
+    const uint8_t* src_p = src->data;
+    uint8_t* dst_p       = dst->data;
+
+    b16_t b16{};
+
+    uint8_t r = 0;
+    uint8_t g = 0;
+    uint8_t b = 0;
+
+    switch (dst->rotate) {
+        case MA_PIXEL_ROTATE_90:
+            for (uint16_t i = 0; i < dh; ++i) {
+                i_mul_bh_sw = ((i * beta_h) >> 16) * sw;
+
+                for (uint16_t j = 0; j < dw; ++j) {
+                    init_index = ((j * beta_w) >> 16) + i_mul_bh_sw;
+                    index      = (j % dw) * dh + ((dh - 1) - ((j / dw) + i));
+
+                    b16 = *reinterpret_cast<const b16_t*>(src_p + (init_index << 1));
+                    r   = RGB565_TO_RGB888_LOOKUP_TABLE_5[(b16.b0_8 & 0xF8) >> 3];
+                    b   = RGB565_TO_RGB888_LOOKUP_TABLE_5[b16.b8_16 & 0x1F];
+                    g   = RGB565_TO_RGB888_LOOKUP_TABLE_6[((b16.b0_8 & 0x07) << 3) |
+                                                        ((b16.b8_16 & 0xE0) >> 5)];
+
+                    dst_p[index]                   = r;
+                    dst_p[index + planar_size]     = g;
+                    dst_p[index + planar_size * 2] = b;
+                }
+            }
+            break;
+
+        case MA_PIXEL_ROTATE_180:
+            for (uint16_t i = 0; i < dh; ++i) {
+                i_mul_bh_sw = ((i * beta_h) >> 16) * sw;
+
+                for (uint16_t j = 0; j < dw; ++j) {
+                    init_index = ((j * beta_w) >> 16) + i_mul_bh_sw;
+                    index      = ((dw - 1) - (j % dw)) + ((dh - 1) - ((j / dw) + i)) * dw;
+
+                    b16 = *reinterpret_cast<const b16_t*>(src_p + (init_index << 1));
+                    r   = RGB565_TO_RGB888_LOOKUP_TABLE_5[(b16.b0_8 & 0xF8) >> 3];
+                    b   = RGB565_TO_RGB888_LOOKUP_TABLE_5[b16.b8_16 & 0x1F];
+                    g   = RGB565_TO_RGB888_LOOKUP_TABLE_6[((b16.b0_8 & 0x07) << 3) |
+                                                        ((b16.b8_16 & 0xE0) >> 5)];
+
+                    dst_p[index]                   = r;
+                    dst_p[index + planar_size]     = g;
+                    dst_p[index + planar_size * 2] = b;
+                }
+            }
+            break;
+
+        case MA_PIXEL_ROTATE_270:
+            for (uint16_t i = 0; i < dh; ++i) {
+                i_mul_bh_sw = ((i * beta_h) >> 16) * sw;
+
+                for (uint16_t j = 0; j < dw; ++j) {
+                    init_index = ((j * beta_w) >> 16) + i_mul_bh_sw;
+                    index      = ((dw - 1) - (j % dw)) * dh + (j / dw) + i;
+
+                    b16 = *reinterpret_cast<const b16_t*>(src_p + (init_index << 1));
+                    r   = RGB565_TO_RGB888_LOOKUP_TABLE_5[(b16.b0_8 & 0xF8) >> 3];
+                    b   = RGB565_TO_RGB888_LOOKUP_TABLE_5[b16.b8_16 & 0x1F];
+                    g   = RGB565_TO_RGB888_LOOKUP_TABLE_6[((b16.b0_8 & 0x07) << 3) |
+                                                        ((b16.b8_16 & 0xE0) >> 5)];
+
+                    dst_p[index]                   = r;
+                    dst_p[index + planar_size]     = g;
+                    dst_p[index + planar_size * 2] = b;
+                }
+            }
+            break;
+
+        default:
+            for (uint16_t i = 0; i < dh; ++i) {
+                i_mul_bh_sw = ((i * beta_h) >> 16) * sw;
+                i_mul_dw    = i * dw;
+
+                for (uint16_t j = 0; j < dw; ++j) {
+                    init_index = ((j * beta_w) >> 16) + i_mul_bh_sw;
+                    index      = j + i_mul_dw;
+
+                    b16 = *reinterpret_cast<const b16_t*>(src_p + (init_index << 1));
+                    r   = RGB565_TO_RGB888_LOOKUP_TABLE_5[(b16.b0_8 & 0xF8) >> 3];
+                    b   = RGB565_TO_RGB888_LOOKUP_TABLE_5[b16.b8_16 & 0x1F];
+                    g   = RGB565_TO_RGB888_LOOKUP_TABLE_6[((b16.b0_8 & 0x07) << 3) |
+                                                        ((b16.b8_16 & 0xE0) >> 5)];
+
+                    dst_p[index]                   = r;
+                    dst_p[index + planar_size]     = g;
+                    dst_p[index + planar_size * 2] = b;
+                }
+            }
+    }
+}
